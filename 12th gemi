  <script>
    // --- 1. Service Worker (Offline Support) ---
    const swCode = `
      const CACHE_NAME = 'aether-focus-v7-complete';
      self.addEventListener('install', (e) => {
        self.skipWaiting();
      });
      self.addEventListener('activate', (e) => {
        e.waitUntil(
          caches.keys().then(keys => Promise.all(
            keys.map(key => {
              if (key !== CACHE_NAME) return caches.delete(key);
            })
          )).then(() => clients.claim())
        );
      });
      self.addEventListener('fetch', (e) => {
        e.respondWith(fetch(e.request).catch(() => caches.match(e.request)));
      });
    `;
    if ('serviceWorker' in navigator) {
      try {
        const swBlob = new Blob([swCode], { type: 'application/javascript' });
        navigator.serviceWorker.register(URL.createObjectURL(swBlob)).catch(err => console.warn(err));
      } catch (e) {}
    }

    // Manifest injection
    const manifestJson = {
      name: "AetherFocus Study Engine",
      short_name: "AetherFocus",
      start_url: window.location.href,
      display: "standalone",
      background_color: "#04060a",
      theme_color: "#04060a",
      icons: [{
        src: "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%2304060a'/><path d='M55 20L25 55h25v25l30-35H55z' fill='%2300f0ff'/></svg>",
        sizes: "192x192 512x512",
        type: "image/svg+xml"
      }]
    };
    const manifestBlob = new Blob([JSON.stringify(manifestJson)], { type: 'application/json' });
    document.getElementById('pwa-manifest').setAttribute('href', URL.createObjectURL(manifestBlob));

    // --- 2. System Utilities (Audio & Wakelock) ---
    let soundMuted = false;
    function playChime(freq = 587.33, freq2 = 880) {
      if (soundMuted) return;
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) return;
        const ctx = new AudioContext();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(freq2, ctx.currentTime + 0.18);
        gain.gain.setValueAtTime(0.25, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.9);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.9);
      } catch (e) { console.warn('Audio error', e); }
    }

    document.getElementById('btn-toggle-sound').addEventListener('click', () => {
      soundMuted = !soundMuted;
      document.getElementById('btn-toggle-sound').style.opacity = soundMuted ? '0.4' : '1';
    });

    let wakeLockSentinel = null;
    let wakeLockRequestedByUser = false;
    async function requestScreenWakeLock() {
      if ('wakeLock' in navigator) {
        try {
          wakeLockSentinel = await navigator.wakeLock.request('screen');
          document.getElementById('btn-toggle-wakelock').classList.add('active');
          document.getElementById('label-wakelock').textContent = 'Wakelock: ACTIVE';
          document.getElementById('wake-lock-badge').style.display = 'inline-flex';
        } catch (err) { console.warn('Wake Lock error:', err); }
      }
    }
    function releaseScreenWakeLock() {
      if (wakeLockSentinel) {
        wakeLockSentinel.release().then(() => {
          wakeLockSentinel = null;
          document.getElementById('btn-toggle-wakelock').classList.remove('active');
          document.getElementById('label-wakelock').textContent = 'Wakelock: Off';
          document.getElementById('wake-lock-badge').style.display = 'none';
        }).catch(() => {});
      }
    }
    document.getElementById('btn-toggle-wakelock').addEventListener('click', () => {
      wakeLockRequestedByUser = !wakeLockRequestedByUser;
      if (wakeLockRequestedByUser) requestScreenWakeLock();
      else releaseScreenWakeLock();
    });
    document.addEventListener('visibilitychange', () => {
      if (wakeLockRequestedByUser && document.visibilityState === 'visible' && !wakeLockSentinel) {
        requestScreenWakeLock();
      }
    });

    function triggerNativeNotification(title, body) {
      if ('Notification' in window && Notification.permission === 'granted') {
        try {
          new Notification(title, {
            body: body,
            icon: "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%2304060a'/><path d='M55 20L25 55h25v25l30-35H55z' fill='%2300f0ff'/></svg>"
          });
        } catch (err) {}
      }
    }
    // Ask permission on load if not determined
    if ('Notification' in window && Notification.permission === 'default') {
      Notification.requestPermission();
    }

    // --- 3. Profile & Core Data Management ---
    const DEFAULT_SUBJECTS = [
      { id: 'sub-1', name: 'Machine Learning', color: '#00f0ff', tag: 'Tech', goalMinutes: 60 },
      { id: 'sub-2', name: 'Electronics', color: '#0070f3', tag: 'Engineering', goalMinutes: 45 }
    ];

    let profiles = JSON.parse(localStorage.getItem('aether_profiles') || '["M", "H"]');
    let currentProfile = localStorage.getItem('aether_active_profile') || profiles[0];
    function sKey(key) { return `${currentProfile}_${key}`; }

    let subjects = [];
    let studyLogs = [];
    let tasks = [];
    let pipelines = [];
    let savedPomoMinutes = 25;

    function loadProfileData() {
      // Update UI Header
      document.getElementById('active-profile-label').textContent = currentProfile;

      // Load Data
      subjects = JSON.parse(localStorage.getItem(sKey('subjects')) || 'null') || DEFAULT_SUBJECTS;
      studyLogs = JSON.parse(localStorage.getItem(sKey('logs')) || 'null') || [];
      tasks = JSON.parse(localStorage.getItem(sKey('tasks')) || 'null') || [];
      
      let loadedPipes = JSON.parse(localStorage.getItem(sKey('pipelines')) || 'null') || [
        { id: 'pipe-1', title: 'Main Project Planner', color: '#00f0ff', nodes: [], edges: [] }
      ];
      // Sanitize pipelines in case of old data formats
      pipelines = loadedPipes.map(p => ({
        ...p,
        nodes: Array.isArray(p.nodes) ? p.nodes : [],
        edges: Array.isArray(p.edges) ? p.edges : []
      }));

      savedPomoMinutes = parseInt(localStorage.getItem(sKey('pomo')) || '25', 10);
      if (isNaN(savedPomoMinutes) || savedPomoMinutes < 1) savedPomoMinutes = 25;

      // Ensure active subject exists
      if (!activeSubjectId || !subjects.find(s => s.id === activeSubjectId)) {
        activeSubjectId = subjects.length > 0 ? subjects[0].id : null;
      }

      // Timer UI init
      updatePomoDuration(savedPomoMinutes);
      populateTimerSubjectSelect();
      restoreActiveSessionState(); // Crucial for background timer

      // Render Views
      updateOverviewStats();
      renderSubjectsList();
      renderCalendar();
      renderAnalytics();
      
      // If we are looking at the pipeline canvas, re-render it, else render dashboard
      if(document.getElementById('pipeline-canvas-area').classList.contains('active') && activePipelineId) {
        renderPipelineNodes();
      } else {
        renderPipelinesDashboard();
      }
    }

    function persistData() {
      localStorage.setItem(sKey('subjects'), JSON.stringify(subjects));
      localStorage.setItem(sKey('logs'), JSON.stringify(studyLogs));
      localStorage.setItem(sKey('tasks'), JSON.stringify(tasks));
      localStorage.setItem(sKey('pipelines'), JSON.stringify(pipelines));
      localStorage.setItem(sKey('pomo'), savedPomoMinutes.toString());

      updateOverviewStats();
      renderSubjectsList();
      renderCalendar();
      renderAnalytics();

      // Only re-render dashboard if we are NOT in the active visual canvas
      // This prevents the visual canvas from collapsing when editing/dragging nodes
      if (!document.getElementById('pipeline-canvas-area').classList.contains('active')) {
        renderPipelinesDashboard();
      }
    }

    // --- Profile Modal Logic ---
    const modalProfiles = document.getElementById('modal-profiles');
    document.getElementById('btn-open-profiles').addEventListener('click', () => {
      renderProfileList();
      modalProfiles.classList.add('open');
    });
    document.getElementById('btn-close-profiles').addEventListener('click', () => {
      modalProfiles.classList.remove('open');
    });

    function renderProfileList() {
      const container = document.getElementById('profile-list-container');
      container.innerHTML = '';
      profiles.forEach(p => {
        const div = document.createElement('div');
        div.style.display = 'flex';
        div.style.justifyContent = 'space-between';
        div.style.alignItems = 'center';
        div.style.padding = '0.75rem';
        div.style.background = 'var(--bg-card)';
        div.style.border = '1px solid var(--border-subtle)';
        div.style.borderRadius = '0.5rem';
        
        const isCurrent = p === currentProfile;
        
        div.innerHTML = `
          <div style="display:flex; align-items:center; gap:0.5rem; cursor:pointer;" class="prof-select">
            <span style="width:12px;height:12px;border-radius:50%;background:${isCurrent ? 'var(--accent-neon)' : 'var(--text-dim)'}"></span>
            <span style="color:${isCurrent ? '#fff' : 'var(--text-secondary)'}; font-weight:700;">${p}</span>
          </div>
          <div style="display:flex; gap:0.5rem;">
            ${!isCurrent && profiles.length > 1 ? `<button class="task-btn delete prof-del" data-p="${p}">Delete</button>` : ''}
          </div>
        `;

        div.querySelector('.prof-select').addEventListener('click', () => switchProfile(p));
        
        const delBtn = div.querySelector('.prof-del');
        if (delBtn) {
          delBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            if(this.textContent === 'Sure?') {
              deleteProfile(p);
            } else {
              this.textContent = 'Sure?';
              this.style.color = 'var(--danger)';
              this.style.background = 'rgba(239,68,68,0.1)';
              setTimeout(() => { 
                if(this) { 
                  this.textContent = 'Delete'; 
                  this.style.color = ''; 
                  this.style.background = '';
                } 
              }, 3000);
            }
          });
        }
        container.appendChild(div);
      });
    }

    function switchProfile(p) {
      if(p === currentProfile) return;
      // Pause timer to save delta to old profile before switching
      if (isRunning) pauseTimer();
      
      currentProfile = p;
      localStorage.setItem('aether_active_profile', currentProfile);
      
      loadProfileData();
      renderProfileList();
    }

    document.getElementById('btn-add-profile').addEventListener('click', () => {
      const name = document.getElementById('input-new-profile').value.trim();
      if(name && !profiles.includes(name)) {
        profiles.push(name);
        localStorage.setItem('aether_profiles', JSON.stringify(profiles));
        document.getElementById('input-new-profile').value = '';
        switchProfile(name);
      }
    });

    function deleteProfile(p) {
      profiles = profiles.filter(x => x !== p);
      localStorage.setItem('aether_profiles', JSON.stringify(profiles));
      // Wipe all localStorage keys belonging to this profile
      Object.keys(localStorage).forEach(key => {
        if(key.startsWith(p + '_')) localStorage.removeItem(key);
      });
      renderProfileList();
    }

    // --- 4. Utilities ---
    function formatTime(seconds) {
      const h = Math.floor(seconds / 3600);
      const m = Math.floor((seconds % 3600) / 60);
      const s = seconds % 60;
      return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    }
    function formatTimeMinSec(seconds) {
      const m = Math.floor(seconds / 60);
      const s = seconds % 60;
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    }
    function formatHours(seconds) {
      return (seconds / 3600).toFixed(1) + ' hrs';
    }
    function getTodayString() {
      return new Date().toISOString().split('T')[0];
    }

    // --- 5. High-Precision Background-Immune Timer ---
    let timerMode = 'stopwatch'; // 'stopwatch' | 'pomodoro'
    let pomoStage = 'focus';     // 'focus' | 'shortBreak' | 'longBreak'
    let timerTargetSeconds = savedPomoMinutes * 60;
    let activeSubjectId = null;

    let isRunning = false;
    let startTimestamp = null;
    let accumulatedSeconds = 0;
    let totalElapsedSeconds = 0;
    let timerTickInterval = null;

    const timerDisplay = document.getElementById('timer-display');
    const timerStatusBadge = document.getElementById('timer-status-badge');
    const timerSelectedTitle = document.getElementById('timer-selected-title');
    const timerToggleBtn = document.getElementById('btn-timer-toggle');
    const timerToggleText = document.getElementById('timer-toggle-text');
    const timerRing = document.getElementById('timer-ring');
    const timerSubjectSelect = document.getElementById('timer-subject-select');
    const sessionNoteInput = document.getElementById('timer-session-note');

    function saveActiveSessionState() {
      const state = {
        isRunning, timerMode, pomoStage, startTimestamp,
        accumulatedSeconds, timerTargetSeconds, activeSubjectId, savedPomoMinutes
      };
      localStorage.setItem(sKey('active_session'), JSON.stringify(state));
    }

    function clearActiveSessionState() {
      localStorage.removeItem(sKey('active_session'));
    }

    function restoreActiveSessionState() {
      const raw = localStorage.getItem(sKey('active_session'));
      if (!raw) {
        resetTimerState();
        return;
      }
      try {
        const state = JSON.parse(raw);
        timerMode = state.timerMode || 'stopwatch';
        pomoStage = state.pomoStage || 'focus';
        timerTargetSeconds = state.timerTargetSeconds || (savedPomoMinutes * 60);
        activeSubjectId = state.activeSubjectId || (subjects.length > 0 ? subjects[0].id : null);
        accumulatedSeconds = state.accumulatedSeconds || 0;
        isRunning = state.isRunning || false;
        startTimestamp = state.startTimestamp || null;

        // UI Sync
        if (timerMode === 'pomodoro') {
          document.getElementById('btn-mode-pomodoro').classList.add('active');
          document.getElementById('btn-mode-stopwatch').classList.remove('active');
          document.getElementById('pomo-customizer-box').classList.remove('hidden');
          document.getElementById('pomo-stage-bar').classList.remove('hidden');
          document.querySelectorAll('.pomo-stage-btn').forEach(btn => {
            btn.classList.toggle('active', btn.getAttribute('data-stage') === pomoStage);
          });
        } else {
          document.getElementById('btn-mode-stopwatch').classList.add('active');
          document.getElementById('btn-mode-pomodoro').classList.remove('active');
          document.getElementById('pomo-customizer-box').classList.add('hidden');
          document.getElementById('pomo-stage-bar').classList.add('hidden');
        }
        populateTimerSubjectSelect();

        // Calculate exact time elapsed while app was closed
        if (isRunning && startTimestamp) {
          const delta = Math.floor((Date.now() - startTimestamp) / 1000);
          totalElapsedSeconds = accumulatedSeconds + Math.max(0, delta);

          if (timerMode === 'pomodoro' && totalElapsedSeconds >= timerTargetSeconds) {
            handlePomodoroCompletedInAbsence();
          } else {
            resumeFromPersistedTimestamp();
          }
        } else {
          totalElapsedSeconds = accumulatedSeconds;
          updateTimerDial();
          updateDynamicTitle();
        }
      } catch (err) {
        resetTimerState();
      }
    }

    function syncTimeDelta() {
      if (!isRunning || !startTimestamp) return;
      const delta = Math.floor((Date.now() - startTimestamp) / 1000);
      totalElapsedSeconds = accumulatedSeconds + Math.max(0, delta);

      if (timerMode === 'pomodoro' && totalElapsedSeconds >= timerTargetSeconds) {
        handleTimerCompletion();
        return;
      }
      updateTimerDial();
      updateDynamicTitle();
    }

    function updateDynamicTitle() {
      const sub = subjects.find(s => s.id === activeSubjectId);
      const subTitle = sub ? sub.name : 'Focus';

      if (!isRunning) {
        document.title = 'AetherFocus - Precision AI Study Engine';
        return;
      }
      if (timerMode === 'pomodoro') {
        const remaining = Math.max(0, timerTargetSeconds - totalElapsedSeconds);
        document.title = `[${formatTimeMinSec(remaining)}] ${subTitle} - AetherFocus`;
      } else {
        document.title = `[${formatTime(totalElapsedSeconds)}] ${subTitle} - AetherFocus`;
      }
    }

    function updateTimerDial() {
      if (timerMode === 'pomodoro') {
        const remaining = Math.max(0, timerTargetSeconds - totalElapsedSeconds);
        timerDisplay.textContent = formatTime(remaining);
        const percent = Math.min(totalElapsedSeconds / timerTargetSeconds, 1);
        timerRing.style.strokeDashoffset = 283 - (percent * 283);
      } else {
        timerDisplay.textContent = formatTime(totalElapsedSeconds);
        const percent = (totalElapsedSeconds % 3600) / 3600;
        timerRing.style.strokeDashoffset = 283 - (percent * 283);
      }
    }

    function startOrResumeTimer() {
      if (isRunning) return;
      isRunning = true;
      startTimestamp = Date.now();
      saveActiveSessionState();

      timerStatusBadge.textContent = (timerMode === 'pomodoro' && pomoStage !== 'focus') ? 'Resting...' : 'Session Active';
      timerToggleText.textContent = 'Pause';
      timerToggleBtn.classList.remove('btn-ctrl-primary');
      timerToggleBtn.classList.add('btn-ctrl-pause');

      if (wakeLockRequestedByUser) requestScreenWakeLock();

      clearInterval(timerTickInterval);
      timerTickInterval = setInterval(syncTimeDelta, 500);
      syncTimeDelta();
    }

    function resumeFromPersistedTimestamp() {
      isRunning = true;
      timerStatusBadge.textContent = 'Session Active';
      timerToggleText.textContent = 'Pause';
      timerToggleBtn.classList.remove('btn-ctrl-primary');
      timerToggleBtn.classList.add('btn-ctrl-pause');
      clearInterval(timerTickInterval);
      timerTickInterval = setInterval(syncTimeDelta, 500);
      syncTimeDelta();
    }

    function pauseTimer() {
      if (!isRunning) return;
      const delta = Math.floor((Date.now() - startTimestamp) / 1000);
      accumulatedSeconds += Math.max(0, delta);
      totalElapsedSeconds = accumulatedSeconds;
      startTimestamp = null;
      isRunning = false;

      clearInterval(timerTickInterval);
      saveActiveSessionState();

      timerStatusBadge.textContent = 'Paused';
      timerToggleText.textContent = 'Resume';
      timerToggleBtn.classList.remove('btn-ctrl-pause');
      timerToggleBtn.classList.add('btn-ctrl-primary');
      updateTimerDial();
      updateDynamicTitle();
    }

    function handleTimerCompletion() {
      pauseTimer();
      playChime(659.25, 880);
      const subName = subjects.find(s => s.id === activeSubjectId)?.name || 'Focus Session';

      triggerNativeNotification(
        pomoStage === 'focus' ? "Time's Up! Focus Complete" : "Break Over!",
        pomoStage === 'focus' ? `Great work! Your session on "${subName}" has been logged.` : "Ready to jump back into focus?"
      );

      timerStatusBadge.textContent = pomoStage === 'focus' ? 'Session Complete!' : 'Break Finished!';
      if (pomoStage === 'focus') stopAndLogTimer();
    }

    function handlePomodoroCompletedInAbsence() {
      if (pomoStage === 'focus' && timerTargetSeconds >= 10) {
        studyLogs.unshift({
          id: 'log-' + Date.now(),
          subjectId: activeSubjectId,
          duration: timerTargetSeconds,
          timestamp: new Date().toISOString(),
          dateString: getTodayString(),
          note: 'Completed Pomodoro session (reconciled after sleep/background).'
        });
        persistData();
      }
      resetTimerState();
      timerStatusBadge.textContent = 'Completed (While Away)';
      const subName = subjects.find(s => s.id === activeSubjectId)?.name || 'Session';
      triggerNativeNotification('Session Finished While Away', `Your study block for "${subName}" was logged.`);
    }

    function stopAndLogTimer() {
      if (isRunning) {
        const delta = Math.floor((Date.now() - startTimestamp) / 1000);
        totalElapsedSeconds = accumulatedSeconds + Math.max(0, delta);
      }
      const durationToLog = (timerMode === 'pomodoro') ? Math.min(totalElapsedSeconds, timerTargetSeconds) : totalElapsedSeconds;

      if (durationToLog >= 5 && (timerMode === 'stopwatch' || pomoStage === 'focus')) {
        studyLogs.unshift({
          id: 'log-' + Date.now(),
          subjectId: activeSubjectId,
          duration: durationToLog,
          timestamp: new Date().toISOString(),
          dateString: getTodayString(),
          note: sessionNoteInput.value.trim() || 'Focused study session completed.'
        });
        persistData();
        playChime(523.25, 783.99);
      }
      resetTimerState();
      sessionNoteInput.value = '';
    }

    function resetTimerState() {
      clearInterval(timerTickInterval);
      isRunning = false;
      startTimestamp = null;
      accumulatedSeconds = 0;
      totalElapsedSeconds = 0;
      clearActiveSessionState();

      timerStatusBadge.textContent = 'Ready';
      timerToggleText.textContent = 'Start Focus';
      timerToggleBtn.classList.remove('btn-ctrl-pause');
      timerToggleBtn.classList.add('btn-ctrl-primary');
      updateTimerDial();
      updateDynamicTitle();
    }

    // Visibility handlers to ensure delta sync is exact
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') syncTimeDelta(); });
    window.addEventListener('focus', syncTimeDelta);
    window.addEventListener('pageshow', syncTimeDelta);

    timerToggleBtn.addEventListener('click', () => { if (isRunning) pauseTimer(); else startOrResumeTimer(); });
    document.getElementById('btn-timer-stop').addEventListener('click', stopAndLogTimer);

    // --- 6. Timer Configuration & Modes ---
    function updatePomoDuration(minutes) {
      const mins = Math.max(1, Math.min(180, parseInt(minutes, 10) || 25));
      savedPomoMinutes = mins;
      localStorage.setItem(sKey('pomo'), mins.toString());

      document.getElementById('input-pomo-minutes').value = mins;
      document.getElementById('pomo-selected-label').textContent = `${mins} Minutes`;

      document.querySelectorAll('#pomo-presets-container .preset-chip').forEach(chip => {
        if (parseInt(chip.getAttribute('data-mins'), 10) === mins) chip.classList.add('active');
        else chip.classList.remove('active');
      });

      if (timerMode === 'pomodoro' && pomoStage === 'focus') {
        timerTargetSeconds = mins * 60;
        if (!isRunning) resetTimerState();
        else { saveActiveSessionState(); updateTimerDial(); }
      }
    }

    function setPomoStage(stage) {
      pomoStage = stage;
      document.querySelectorAll('.pomo-stage-btn').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-stage') === stage);
      });

      if (stage === 'focus') {
        timerTargetSeconds = savedPomoMinutes * 60;
        timerStatusBadge.textContent = 'Focus Session';
        syncActiveSubjectUI();
      } else if (stage === 'shortBreak') {
        timerTargetSeconds = 5 * 60;
        timerStatusBadge.textContent = 'Short Break (5m)';
        timerRing.style.stroke = 'var(--break-green)';
      } else if (stage === 'longBreak') {
        timerTargetSeconds = 15 * 60;
        timerStatusBadge.textContent = 'Long Break (15m)';
        timerRing.style.stroke = 'var(--break-purple)';
      }
      resetTimerState();
    }

    document.querySelectorAll('#pomo-presets-container .preset-chip').forEach(chip => {
      chip.addEventListener('click', () => updatePomoDuration(parseInt(chip.getAttribute('data-mins'), 10)));
    });
    document.getElementById('btn-step-dec').addEventListener('click', () => updatePomoDuration(savedPomoMinutes - 5));
    document.getElementById('btn-step-inc').addEventListener('click', () => updatePomoDuration(savedPomoMinutes + 5));
    document.getElementById('input-pomo-minutes').addEventListener('change', (e) => updatePomoDuration(e.target.value));

    document.querySelectorAll('.pomo-stage-btn').forEach(btn => {
      btn.addEventListener('click', () => setPomoStage(btn.getAttribute('data-stage')));
    });

    document.getElementById('btn-mode-stopwatch').addEventListener('click', function() {
      this.classList.add('active');
      document.getElementById('btn-mode-pomodoro').classList.remove('active');
      document.getElementById('pomo-customizer-box').classList.add('hidden');
      document.getElementById('pomo-stage-bar').classList.add('hidden');
      timerMode = 'stopwatch';
      syncActiveSubjectUI();
      resetTimerState();
    });

    document.getElementById('btn-mode-pomodoro').addEventListener('click', function() {
      this.classList.add('active');
      document.getElementById('btn-mode-stopwatch').classList.remove('active');
      document.getElementById('pomo-customizer-box').classList.remove('hidden');
      document.getElementById('pomo-stage-bar').classList.remove('hidden');
      timerMode = 'pomodoro';
      setPomoStage('focus');
      resetTimerState();
    });

    function populateTimerSubjectSelect() {
      timerSubjectSelect.innerHTML = '';
      subjects.forEach(s => {
        const opt = document.createElement('option');
        opt.value = s.id;
        opt.textContent = `${s.name} (${s.tag || 'General'})`;
        if (s.id === activeSubjectId) opt.selected = true;
        timerSubjectSelect.appendChild(opt);
      });
      syncActiveSubjectUI();
    }

    function syncActiveSubjectUI() {
      const sub = subjects.find(s => s.id === activeSubjectId) || subjects[0];
      if (sub) {
        timerSelectedTitle.textContent = sub.name;
        if (timerMode === 'pomodoro') {
          if (pomoStage === 'shortBreak') timerRing.style.stroke = 'var(--break-green)';
          else if (pomoStage === 'longBreak') timerRing.style.stroke = 'var(--break-purple)';
          else timerRing.style.stroke = sub.color;
        } else {
          timerRing.style.stroke = sub.color;
        }
      }
    }

    timerSubjectSelect.addEventListener('change', (e) => {
      activeSubjectId = e.target.value;
      syncActiveSubjectUI();
      saveActiveSessionState();
    });

    // --- 7. Overview & Analytics Data ---
    function updateOverviewStats() {
      const today = getTodayString();
      const pastWeek = new Date(); pastWeek.setDate(pastWeek.getDate() - 7);
      let todaySecs = 0, todayCount = 0, weekSecs = 0;

      studyLogs.forEach(log => {
        if (log.dateString === today) { todaySecs += log.duration; todayCount++; }
        if (new Date(log.dateString) >= pastWeek) weekSecs += log.duration;
      });

      document.getElementById('stat-today').textContent = formatTime(todaySecs);
      document.getElementById('stat-today-sub').textContent = `${todayCount} sessions logged today`;
      document.getElementById('stat-week').textContent = formatHours(weekSecs);

      // Streak calculation
      const activeDays = new Set(studyLogs.map(l => l.dateString));
      let streak = 0; let check = new Date();
      while (true) {
        const dStr = check.toISOString().split('T')[0];
        if (activeDays.has(dStr)) {
          streak++; check.setDate(check.getDate() - 1);
        } else {
          if (streak === 0) {
            check.setDate(check.getDate() - 1);
            if (activeDays.has(check.toISOString().split('T')[0])) {
              streak++; check.setDate(check.getDate() - 1); continue;
            }
          }
          break;
        }
      }
      document.getElementById('stat-streak').textContent = `${streak} Days`;
    }

    function renderSubjectsList() {
      const container = document.getElementById('subjects-container');
      container.innerHTML = '';
      const today = getTodayString();

      subjects.forEach(sub => {
        const subLogs = studyLogs.filter(l => l.subjectId === sub.id);
        const totalSecs = subLogs.reduce((acc, curr) => acc + curr.duration, 0);
        const todaySecs = subLogs.filter(l => l.dateString === today).reduce((acc, curr) => acc + curr.duration, 0);
        const isCurrentActive = (activeSubjectId === sub.id && isRunning);

        const card = document.createElement('div');
        card.className = `subject-card ${isCurrentActive ? 'is-active-subject' : ''}`;
        card.innerHTML = `
          <div>
            <div class="subject-head">
              <span class="subject-pill"><span class="subject-color-dot" style="background: ${sub.color};"></span> ${sub.tag || 'General'}</span>
              <div class="subject-actions">
                <button class="icon-btn edit-sub" style="width:1.75rem; height:1.75rem;" title="Edit"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
                <button class="icon-btn del-sub" style="width:1.75rem; height:1.75rem;" title="Delete"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
              </div>
            </div>
            <h3 class="subject-name">${sub.name}</h3>
            <div class="subject-time-summary">
              <div><span>Today</span><strong>${formatTime(todaySecs)}</strong></div>
              <div><span>Total</span><strong style="color:#f8fafc;">${formatHours(totalSecs)}</strong></div>
            </div>
          </div>
          <button class="subject-btn-launch launch-timer"><svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg> ${isCurrentActive ? 'Timer Active' : 'Launch Study Timer'}</button>
        `;

        card.querySelector('.launch-timer').addEventListener('click', (e) => {
          e.stopPropagation(); activeSubjectId = sub.id; populateTimerSubjectSelect();
          switchTab('timer'); startOrResumeTimer();
        });
        card.querySelector('.edit-sub').addEventListener('click', (e) => { e.stopPropagation(); openSubjectModal(sub); });
        card.querySelector('.del-sub').addEventListener('click', (e) => {
          e.stopPropagation();
          if (confirm(`Delete "${sub.name}" and its logs?`)) {
            subjects = subjects.filter(s => s.id !== sub.id);
            studyLogs = studyLogs.filter(l => l.subjectId !== sub.id);
            if (activeSubjectId === sub.id) activeSubjectId = subjects[0]?.id || null;
            persistData(); populateTimerSubjectSelect();
          }
        });
        card.addEventListener('click', () => {
          activeSubjectId = sub.id; populateTimerSubjectSelect(); switchTab('timer');
        });
        container.appendChild(card);
      });
    }

    function renderAnalytics() {
      const container = document.getElementById('analytics-distribution-list');
      container.innerHTML = '';
      const totalAllTime = studyLogs.reduce((acc, curr) => acc + curr.duration, 0) || 1;

      subjects.forEach(sub => {
        const subSecs = studyLogs.filter(l => l.subjectId === sub.id).reduce((acc, curr) => acc + curr.duration, 0);
        const pct = ((subSecs / totalAllTime) * 100).toFixed(1);

        const row = document.createElement('div');
        row.className = 'breakdown-row';
        row.innerHTML = `
          <div class="breakdown-info">
            <div style="display:flex; align-items:center; gap: 0.4rem;">
              <span style="width:8px; height:8px; border-radius:50%; background:${sub.color};"></span>
              <span style="font-weight:600; color:#fff;">${sub.name}</span>
            </div>
            <div>
              <span class="font-mono" style="color:var(--text-secondary); margin-right: 0.5rem;">${formatHours(subSecs)}</span>
              <span class="font-mono text-neon" style="font-weight:700;">${pct}%</span>
            </div>
          </div>
          <div class="progress-bar-bg"><div class="progress-bar-fill" style="width: ${pct}%; background: ${sub.color};"></div></div>
        `;
        container.appendChild(row);
      });
    }

    // --- 8. Heatmap Calendar & Checklist ---
    function renderCalendar() {
      const grid = document.getElementById('calendar-grid-cells');
      grid.innerHTML = '';
      const d = new Date(selectedCalDayStr + 'T00:00:00');
      document.getElementById('cal-month-label').textContent = d.toLocaleString('default', { month: 'short', year: 'numeric' });
      
      const year = d.getFullYear(), month = d.getMonth();
      const firstDay = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      
      ['S','M','T','W','T','F','S'].forEach(day => {
        const l = document.createElement('div'); l.className = 'calendar-day-label'; l.textContent = day; grid.appendChild(l);
      });
      for(let i=0; i<firstDay; i++) {
        const b = document.createElement('div'); b.className = 'cal-day-empty'; grid.appendChild(b);
      }
      for(let day=1; day<=daysInMonth; day++) {
        const ds = `${year}-${String(month+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
        const dayLogs = studyLogs.filter(l => l.dateString === ds);
        const daySecs = dayLogs.reduce((sum, l) => sum + l.duration, 0);
        const hrs = daySecs/3600;
        let hc = 'heat-lvl-0';
        if(daySecs>0) hc = hrs<0.75?'heat-lvl-1':hrs<1.75?'heat-lvl-2':hrs<3?'heat-lvl-3':'heat-lvl-4';
        
        const cell = document.createElement('div');
        cell.className = `cal-day-cell ${hc} ${selectedCalDayStr===ds ? 'is-selected':''}`;
        cell.textContent = day;
        cell.onclick = () => { selectedCalDayStr = ds; renderCalendar(); };
        grid.appendChild(cell);
      }
      renderChecklist(selectedCalDayStr);
    }

    document.getElementById('cal-prev').onclick = () => { const d = new Date(selectedCalDayStr + 'T00:00:00'); d.setMonth(d.getMonth()-1); selectedCalDayStr = d.toISOString().split('T')[0]; renderCalendar(); };
    document.getElementById('cal-next').onclick = () => { const d = new Date(selectedCalDayStr + 'T00:00:00'); d.setMonth(d.getMonth()+1); selectedCalDayStr = d.toISOString().split('T')[0]; renderCalendar(); };

    // Checklist Logic
    let draggedTask = null;

    function renderChecklist(dateStr) {
      document.getElementById('cal-inspect-date').textContent = new Date(dateStr + 'T00:00:00').toLocaleDateString(undefined, { weekday:'short', month:'short', day:'numeric' });
      const daySecs = studyLogs.filter(l => l.dateString === dateStr).reduce((s, l) => s + l.duration, 0);
      document.getElementById('cal-inspect-total').textContent = (daySecs/3600).toFixed(1) + ' hrs logged';

      const container = document.getElementById('checklist-container');
      container.innerHTML = '';

      let dayTasks = tasks.filter(t => t.type === 'everyday' || t.dateString === dateStr);
      dayTasks.sort((a,b) => (a.order||0) - (b.order||0));

      let completedCount = 0;
      
      dayTasks.forEach((task, index) => {
        const isDone = task.completedOn && task.completedOn.includes(dateStr);
        if(isDone) completedCount++;

        const card = document.createElement('div');
        card.className = `task-card ${isDone ? 'completed' : ''}`;
        card.draggable = true;
        
        card.innerHTML = `
          <div class="task-drag-handle"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="5" r="1"/><circle cx="9" cy="12" r="1"/><circle cx="9" cy="19" r="1"/><circle cx="15" cy="5" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="15" cy="19" r="1"/></svg></div>
          <span class="task-num">${index + 1}.</span>
          <label class="task-checkbox-wrap">
            <input type="checkbox" ${isDone ? 'checked' : ''}>
            <svg class="task-checkbox-svg" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </label>
          <div class="task-content">
            <div style="display:flex; align-items:center;">
              <span class="task-title">${task.title}</span>
              <span class="task-badge ${task.type==='everyday'?'badge-everyday':'badge-once'}">${task.type==='everyday'?'Global':'Daily'}</span>
            </div>
            ${task.desc ? `<span class="task-desc">${task.desc}</span>` : ''}
          </div>
          <div class="task-actions">
            <button class="task-btn edit" title="Edit"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
            <button class="task-btn delete" title="Delete"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
          </div>
        `;

        // Checkbox Toggle
        card.querySelector('input').addEventListener('change', (e) => {
          if(!task.completedOn) task.completedOn = [];
          if(e.target.checked) task.completedOn.push(dateStr);
          else task.completedOn = task.completedOn.filter(d => d !== dateStr);
          persistData(); // re-renders UI instantly
        });

        // Edit/Delete
        card.querySelector('.edit').onclick = () => openTaskModal(task);
        card.querySelector('.delete').onclick = () => { 
          // Custom confirm UI not strictly needed here, standard confirm is fast, but we'll use standard for simplicity 
          if(confirm('Delete this task?')) { tasks = tasks.filter(t => t.id !== task.id); persistData(); } 
        };

        // Desktop Drag & Drop
        card.addEventListener('dragstart', (e) => { draggedTask = task; card.classList.add('is-dragging'); });
        card.addEventListener('dragend', () => { card.classList.remove('is-dragging'); draggedTask = null; });
        card.addEventListener('dragover', (e) => { e.preventDefault(); });
        card.addEventListener('drop', (e) => {
          e.preventDefault();
          if(draggedTask && draggedTask.id !== task.id) {
            let dt = tasks.find(t => t.id === draggedTask.id);
            let tt = tasks.find(t => t.id === task.id);
            let temp = dt.order || 0; dt.order = tt.order || 0; tt.order = temp;
            persistData();
          }
        });
        
        // Mobile Touch Drag Polyfill
        const handle = card.querySelector('.task-drag-handle');
        handle.addEventListener('touchstart', (e) => { draggedTask = task; card.classList.add('is-dragging'); }, {passive:true});
        handle.addEventListener('touchmove', (e) => { 
          e.preventDefault(); 
          const touch = e.touches[0]; 
          const target = document.elementFromPoint(touch.clientX, touch.clientY); 
          const dropCard = target?.closest('.task-card'); 
          if(dropCard && dropCard !== card) { 
            dropCard.style.borderTop = "2px solid var(--accent-neon)"; 
          } 
        });
        handle.addEventListener('touchend', (e) => {
          card.classList.remove('is-dragging');
          const touch = e.changedTouches[0]; 
          const target = document.elementFromPoint(touch.clientX, touch.clientY); 
          const dropCard = target?.closest('.task-card');
          document.querySelectorAll('.task-card').forEach(c => c.style.borderTop="");
          if(dropCard && dropCard !== card && draggedTask) {
             const dropIndex = Array.from(container.children).indexOf(dropCard);
             if(dropIndex > -1) {
                let dt = tasks.find(t => t.id === draggedTask.id);
                let targetId = dayTasks[dropIndex].id;
                let tt = tasks.find(t => t.id === targetId);
                let temp = dt.order || 0; dt.order = tt.order || 0; tt.order = temp;
                persistData();
             }
          }
          draggedTask = null;
        });

        container.appendChild(card);
      });

      // Progress Bar Update
      const total = dayTasks.length;
      document.getElementById('checklist-progress-ratio').textContent = `${completedCount}/${total} Completed`;
      document.getElementById('checklist-progress-fill').style.width = total === 0 ? '0%' : `${(completedCount/total)*100}%`;
    }

    // --- 9. Visual Node Pipeline Planner ---
    let activePipelineId = null;
    let draggingNodeId = null;
    let dragOffset = { x: 0, y: 0 };
    let drawingEdge = null; // { sourceId, startX, startY, endX, endY }
    
    // Camera State
    let camX = 0, camY = 0, camZoom = 1;
    let isPanning = false, lastPanX = 0, lastPanY = 0;
    let initialPinchDist = 0, initialCamZoom = 1, lastTouchCenter = null;

    function renderPipelinesDashboard() {
      const dash = document.getElementById('pipeline-dashboard');
      dash.innerHTML = `
        <div class="pipeline-card" style="border-style:dashed; display:flex; align-items:center; justify-content:center; color:var(--text-dim);" onclick="addPipeline()">
          <div style="text-align:center;"><div style="font-size:2rem;">+</div><div style="font-size:0.8rem; font-weight:700;">New Pipeline</div></div>
        </div>
      `;
      pipelines.forEach(p => {
        const card = document.createElement('div');
        card.className = 'pipeline-card';
        card.innerHTML = `
          <div class="pipeline-card-header">
            <span class="pipeline-color-dot" style="background:${p.color}"></span>
            <span class="pipeline-title">${p.title}</span>
          </div>
          <div class="pipeline-meta">
            <span>${p.nodes.length} Nodes &bull; Visual Planner</span>
            <button class="task-btn delete" style="padding:0;" onclick="event.stopPropagation(); deletePipeline('${p.id}')">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            </button>
          </div>
        `;
        card.onclick = () => openPipeline(p.id);
        dash.appendChild(card);
      });
    }

    function addPipeline() {
      const p = { id: 'pipe-'+Date.now(), title: 'New Pipeline Plan', color: '#00f0ff', nodes: [], edges: [] };
      pipelines.push(p); 
      persistData(); 
      openPipeline(p.id);
    }
    
    function deletePipeline(id) {
      if(confirm('Delete this pipeline and all its nodes?')) { 
        pipelines = pipelines.filter(p => p.id !== id); 
        persistData(); 
      }
    }

    function openPipeline(id) {
      activePipelineId = id;
      document.getElementById('pipeline-dashboard').style.display = 'none';
      document.getElementById('pipeline-canvas-area').classList.add('active');
      const p = pipelines.find(x => x.id === id);
      document.getElementById('active-pipeline-title').textContent = p.title;
      document.getElementById('active-pipeline-title').style.color = p.color;
      
      // Reset Camera
      camX = 0; camY = 0; camZoom = 1;
      applyCamera();
      renderPipelineNodes();
    }
    
    document.getElementById('btn-back-pipelines').onclick = () => {
      activePipelineId = null;
      document.getElementById('pipeline-canvas-area').classList.remove('active');
      document.getElementById('pipeline-dashboard').style.display = 'grid';
      renderPipelinesDashboard();
    };
    
    document.getElementById('btn-reset-cam').onclick = () => { 
      camX = 0; camY = 0; camZoom = 1; applyCamera(); 
    };

    function applyCamera() {
      document.getElementById('pipeline-canvas-layer').style.transform = `translate(${camX}px, ${camY}px) scale(${camZoom})`;
    }
    
    // Coordinate converter
    function getCanvasCoords(clientX, clientY) {
      const rect = document.getElementById('pipeline-board').getBoundingClientRect();
      return {
        x: (clientX - rect.left - camX) / camZoom,
        y: (clientY - rect.top - camY) / camZoom
      };
    }

    function renderPipelineNodes() {
      if(!activePipelineId) return;
      const p = pipelines.find(x => x.id === activePipelineId);
      if(!p) return;

      const svg = document.getElementById('pipeline-svg');
      const container = document.getElementById('pipeline-nodes-container');
      svg.innerHTML = ''; container.innerHTML = '';

      // Draw Edges
      p.edges.forEach(edge => {
        const src = p.nodes.find(n => n.id === edge.source);
        const tgt = p.nodes.find(n => n.id === edge.target);
        if(!src || !tgt) return;
        
        const startX = src.x + 240; // width
        const startY = src.y + 36;  // height/2
        const endX = tgt.x;
        const endY = tgt.y + 36;
        
        const isCompleted = src.status === 'completed' && tgt.status === 'completed';
        const color = isCompleted ? '#238636' : '#30363d';
        const curv = Math.max(Math.abs(endX - startX) / 2, 40);
        const d = `M ${startX} ${startY} C ${startX+curv} ${startY}, ${endX-curv} ${endY}, ${endX} ${endY}`;
        
        const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        g.style.cursor = 'pointer'; g.style.pointerEvents = 'stroke';
        g.onclick = (e) => { e.stopPropagation(); p.edges = p.edges.filter(x => x.id !== edge.id); persistData(); renderPipelineNodes(); };
        
        const hitPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        hitPath.setAttribute('d', d); hitPath.setAttribute('stroke', 'transparent'); hitPath.setAttribute('stroke-width', '25'); hitPath.setAttribute('fill', 'none');
        
        const visPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        visPath.setAttribute('d', d); visPath.setAttribute('stroke', color); visPath.setAttribute('stroke-width', '2.5'); visPath.setAttribute('fill', 'none');
        
        g.onmouseenter = () => visPath.setAttribute('stroke', '#ef4444');
        g.onmouseleave = () => visPath.setAttribute('stroke', color);
        
        g.appendChild(hitPath); g.appendChild(visPath); svg.appendChild(g);
      });

      // Draw active dragging edge
      if(drawingEdge) {
        const curv = Math.max(Math.abs(drawingEdge.endX - drawingEdge.startX) / 2, 40);
        const d = `M ${drawingEdge.startX} ${drawingEdge.startY} C ${drawingEdge.startX+curv} ${drawingEdge.startY}, ${drawingEdge.endX-curv} ${drawingEdge.endY}, ${drawingEdge.endX} ${drawingEdge.endY}`;
        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        path.setAttribute('d', d); path.setAttribute('stroke', '#8b949e'); path.setAttribute('stroke-width', '2'); path.setAttribute('stroke-dasharray', '5,5'); path.setAttribute('fill', 'none');
        svg.appendChild(path);
      }

      // Draw Nodes
      p.nodes.forEach(node => {
        const div = document.createElement('div');
        div.className = `node-element ${node.status==='completed'?'completed':''} ${draggingNodeId===node.id?'is-dragging':''}`;
        div.style.transform = `translate(${node.x}px, ${node.y}px)`;
        
        div.innerHTML = `
          <div class="node-drag-handle"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="5" r="1"/><circle cx="9" cy="12" r="1"/><circle cx="9" cy="19" r="1"/><circle cx="15" cy="5" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="15" cy="19" r="1"/></svg></div>
          <div class="node-port node-port-in"><div class="node-port-inner"></div></div>
          <button class="node-status-btn">
            ${node.status==='completed' 
              ? `<svg width="18" height="18" fill="#238636" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>` 
              : `<svg width="18" height="18" fill="#8b949e" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/></svg>`}
          </button>
          <div class="node-content">
            <input type="text" class="node-title-input" value="${node.title}" style="display:none;">
            <div class="node-title-display" title="Click to edit">${node.title}</div>
            <span class="node-priority-badge" style="color:var(--accent-neon); border-color:var(--border-subtle);">${node.priority||'Med'}</span>
          </div>
          <div class="node-port node-port-out"><div class="node-port-inner"></div></div>
          <button class="task-btn delete" style="position:absolute; right:8px; top:8px; padding:2px;"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
        `;

        // Interaction Listeners
        const titleDisp = div.querySelector('.node-title-display');
        const titleInp = div.querySelector('.node-title-input');
        titleDisp.onclick = (e) => { e.stopPropagation(); titleDisp.style.display='none'; titleInp.style.display='block'; titleInp.focus(); };
        titleInp.onblur = () => { node.title = titleInp.value || 'Task'; persistData(); renderPipelineNodes(); };
        titleInp.onkeydown = (e) => { if(e.key === 'Enter') titleInp.blur(); };
        
        div.querySelector('.node-status-btn').onclick = (e) => { e.stopPropagation(); node.status = node.status==='completed'?'pending':'completed'; persistData(); renderPipelineNodes(); };
        div.querySelector('.node-priority-badge').onclick = (e) => { e.stopPropagation(); const p = ['Low','Med','High']; node.priority = p[(p.indexOf(node.priority)+1)%3]; persistData(); renderPipelineNodes(); };
        div.querySelector('.delete').onclick = (e) => { e.stopPropagation(); p.nodes = p.nodes.filter(x => x.id !== node.id); p.edges = p.edges.filter(x => x.source !== node.id && x.target !== node.id); persistData(); renderPipelineNodes(); };
        
        // Node Dragging Pointer Events
        div.onpointerdown = (e) => {
          if(e.target.closest('button, input, .node-port')) return;
          e.stopPropagation();
          draggingNodeId = node.id;
          const coords = getCanvasCoords(e.clientX, e.clientY);
          dragOffset = { x: coords.x - node.x, y: coords.y - node.y };
          renderPipelineNodes(); // for z-index styling bump
        };
        
        // Edge Drawing
        const outPort = div.querySelector('.node-port-out');
        outPort.onpointerdown = (e) => {
          e.stopPropagation(); e.preventDefault();
          const coords = getCanvasCoords(e.clientX, e.clientY);
          drawingEdge = { sourceId: node.id, startX: node.x + 240, startY: node.y + 36, endX: coords.x, endY: coords.y };
          renderPipelineNodes();
        };
        
        container.appendChild(div);
      });
    }

    document.getElementById('btn-add-node').onclick = () => {
      const p = pipelines.find(x => x.id === activePipelineId);
      if(p) {
        // Drop node near center of current view
        const centerX = (-camX + 300) / camZoom;
        const centerY = (-camY + 200) / camZoom;
        p.nodes.push({ id: 'n-'+Date.now(), title: 'New Plan Node', status: 'pending', priority: 'Med', x: centerX, y: centerY });
        persistData(); renderPipelineNodes();
      }
    };

    // Global Pan, Zoom & Drag Handlers on the Board
    const board = document.getElementById('pipeline-board');
    
    // Desktop Wheel Zoom
    board.addEventListener('wheel', (e) => {
      if (!activePipelineId) return;
      e.preventDefault();
      const zoomDelta = e.deltaY > 0 ? 0.9 : 1.1;
      const newZoom = Math.min(Math.max(0.2, camZoom * zoomDelta), 3);
      
      const rect = board.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;

      camX = mouseX - (mouseX - camX) * (newZoom / camZoom);
      camY = mouseY - (mouseY - camY) * (newZoom / camZoom);
      camZoom = newZoom;
      applyCamera();
    }, { passive: false });

    // Touch & Pointer global handling
    board.addEventListener('touchstart', (e) => {
      if(e.touches.length === 2) {
        isPanning = false;
        initialPinchDist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
        initialCamZoom = camZoom;
        lastTouchCenter = { x: (e.touches[0].clientX + e.touches[1].clientX)/2, y: (e.touches[0].clientY + e.touches[1].clientY)/2 };
      } else if (e.touches.length === 1 && !draggingNodeId && !drawingEdge) {
        if(e.target === board || e.target.closest('#pipeline-svg')) {
          isPanning = true; lastPanX = e.touches[0].clientX; lastPanY = e.touches[0].clientY;
        }
      }
    }, { passive: false });

    window.addEventListener('pointermove', (e) => {
      if(!activePipelineId) return;
      
      // Handle node dragging
      if(draggingNodeId) {
        const p = pipelines.find(x => x.id === activePipelineId);
        const node = p.nodes.find(n => n.id === draggingNodeId);
        if(node) {
          const coords = getCanvasCoords(e.clientX, e.clientY);
          node.x = coords.x - dragOffset.x;
          node.y = coords.y - dragOffset.y;
          renderPipelineNodes(); 
        }
      } 
      // Handle edge drawing
      else if (drawingEdge) {
        const coords = getCanvasCoords(e.clientX, e.clientY);
        drawingEdge.endX = coords.x; drawingEdge.endY = coords.y;
        renderPipelineNodes();
      }
    });

    board.addEventListener('touchmove', (e) => {
      if(e.touches.length === 2) {
        e.preventDefault();
        const currentDist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
        const newZoom = Math.min(Math.max(0.2, initialCamZoom * (currentDist / initialPinchDist)), 3);
        const currentCenter = { x: (e.touches[0].clientX + e.touches[1].clientX)/2, y: (e.touches[0].clientY + e.touches[1].clientY)/2 };
        
        const rect = board.getBoundingClientRect();
        const mouseX = currentCenter.x - rect.left;
        const mouseY = currentCenter.y - rect.top;

        camX = mouseX - (mouseX - camX) * (newZoom / camZoom) + (currentCenter.x - lastTouchCenter.x);
        camY = mouseY - (mouseY - camY) * (newZoom / camZoom) + (currentCenter.y - lastTouchCenter.y);
        camZoom = newZoom; lastTouchCenter = currentCenter;
        applyCamera();
      } else if (isPanning && e.touches.length === 1) {
        e.preventDefault();
        camX += e.touches[0].clientX - lastPanX; camY += e.touches[0].clientY - lastPanY;
        lastPanX = e.touches[0].clientX; lastPanY = e.touches[0].clientY;
        applyCamera();
      }
    }, { passive: false });

    // Desktop Mouse Panning
    board.addEventListener('pointerdown', (e) => {
      if(e.pointerType === 'mouse' && !draggingNodeId && !drawingEdge && (e.target === board || e.target.closest('#pipeline-svg'))) {
        isPanning = true; lastPanX = e.clientX; lastPanY = e.clientY;
      }
    });
    window.addEventListener('pointermove', (e) => {
      if(isPanning && e.pointerType === 'mouse') {
        camX += e.clientX - lastPanX; camY += e.clientY - lastPanY;
        lastPanX = e.clientX; lastPanY = e.clientY;
        applyCamera();
      }
    });

    window.addEventListener('pointerup', (e) => {
      isPanning = false;
      if (draggingNodeId) { draggingNodeId = null; persistData(); renderPipelineNodes(); }
      
      if (drawingEdge) {
        // --- MAGNETIC EDGE SNAPPING ---
        const p = pipelines.find(x => x.id === activePipelineId);
        let targetNodeId = null;
        let closestDist = Infinity;
        const snapRadius = 60 / camZoom; // Generous drop area scaled by zoom
        const dropCoords = getCanvasCoords(e.clientX, e.clientY);
        
        p.nodes.forEach(n => {
          if (n.id === drawingEdge.sourceId) return;
          const portX = n.x; // Input port is left edge
          const portY = n.y + 36; // vertically centered
          const dist = Math.hypot(dropCoords.x - portX, dropCoords.y - portY);
          if (dist < snapRadius && dist < closestDist) {
            closestDist = dist; targetNodeId = n.id;
          }
        });

        if (targetNodeId) {
          const exists = p.edges.some(x => (x.source===drawingEdge.sourceId && x.target===targetNodeId) || (x.target===drawingEdge.sourceId && x.source===targetNodeId));
          if(!exists) p.edges.push({ id: 'edge-'+Date.now(), source: drawingEdge.sourceId, target: targetNodeId });
        }
        
        drawingEdge = null; persistData(); renderPipelineNodes();
      }
    });

    // --- 10. Forms, Modals & Navigation logic ---

    function switchTab(tabId) {
      document.querySelectorAll('.tab-view').forEach(view => view.classList.add('hidden'));
      const activeView = document.getElementById(`view-${tabId}`);
      if (activeView) activeView.classList.remove('hidden');

      document.querySelectorAll('#desktop-tabs .nav-btn, #mobile-tabs .mobile-nav-btn').forEach(btn => {
        if (btn.getAttribute('data-tab') === tabId) btn.classList.add('active');
        else btn.classList.remove('active');
      });

      if (tabId === 'calendar') renderCalendar();
      if (tabId === 'analytics') renderAnalytics();
      if (tabId === 'timer') syncActiveSubjectUI();
      if (tabId === 'pipelines') {
        if (activePipelineId) renderPipelineNodes();
        else renderPipelinesDashboard();
      }
    }

    document.querySelectorAll('#desktop-tabs .nav-btn, #mobile-tabs .mobile-nav-btn').forEach(btn => {
      btn.addEventListener('click', () => switchTab(btn.getAttribute('data-tab')));
    });

    // Modals
    const modalTask = document.getElementById('modal-task');
    const modalSubject = document.getElementById('modal-subject');
    const formSubject = document.getElementById('form-subject');
    const formTask = document.getElementById('form-task');
    let selectedColor = '#00f0ff';

    // Subject Logic
    function openSubjectModal(editSub = null) {
      document.getElementById('sub-id').value = editSub ? editSub.id : '';
      document.getElementById('sub-name').value = editSub ? editSub.name : '';
      document.getElementById('sub-tag').value = editSub ? editSub.tag : '';
      document.getElementById('sub-goal').value = editSub ? editSub.goalMinutes : 60;
      document.getElementById('modal-subject-title').textContent = editSub ? 'Edit Study Subject' : 'Add Study Subject';

      selectedColor = editSub ? editSub.color : '#00f0ff';
      document.querySelectorAll('.color-option').forEach(opt => {
        opt.classList.toggle('selected', opt.getAttribute('data-color') === selectedColor);
      });
      modalSubject.classList.add('open');
    }

    document.getElementById('btn-add-subject').addEventListener('click', () => openSubjectModal());
    document.getElementById('btn-cancel-subject').addEventListener('click', () => modalSubject.classList.remove('open'));

    document.querySelectorAll('.color-option').forEach(opt => {
      opt.addEventListener('click', () => {
        document.querySelectorAll('.color-option').forEach(o => o.classList.remove('selected'));
        opt.classList.add('selected');
        selectedColor = opt.getAttribute('data-color');
      });
    });

    formSubject.addEventListener('submit', (e) => {
      e.preventDefault();
      const id = document.getElementById('sub-id').value;
      const name = document.getElementById('sub-name').value.trim();
      const tag = document.getElementById('sub-tag').value.trim() || 'Core';
      const goalMinutes = parseInt(document.getElementById('sub-goal').value, 10) || 60;

      if (!name) return;

      if (id) {
        subjects = subjects.map(s => s.id === id ? { ...s, name, tag, goalMinutes, color: selectedColor } : s);
      } else {
        const newSub = { id: 'sub-' + Date.now(), name, tag, goalMinutes, color: selectedColor };
        subjects.push(newSub);
        if (!activeSubjectId) activeSubjectId = newSub.id;
      }
      persistData();
      populateTimerSubjectSelect();
      modalSubject.classList.remove('open');
    });

    // Task Logic
    document.getElementById('btn-add-task').addEventListener('click', () => openTaskModal());

    function openTaskModal(t = null) {
      document.getElementById('task-id').value = t ? t.id : '';
      document.getElementById('task-title').value = t ? t.title : '';
      document.getElementById('task-desc').value = t ? (t.desc || '') : '';
      document.getElementById('task-type').value = t ? t.type : 'daily';
      document.getElementById('modal-task-title').textContent = t ? 'Edit Task' : 'New Task';
      modalTask.classList.add('open');
    }

    formTask.addEventListener('submit', (e) => {
      e.preventDefault();
      const id = document.getElementById('task-id').value;
      const title = document.getElementById('task-title').value.trim();
      const desc = document.getElementById('task-desc').value.trim();
      const type = document.getElementById('task-type').value;

      if (id) {
        tasks = tasks.map(t => t.id === id ? { ...t, title, desc, type } : t);
      } else {
        tasks.push({ id: 't-' + Date.now(), title, desc, type, dateString: selectedCalDayStr, completedOn: [], order: tasks.length });
      }
      persistData();
      modalTask.classList.remove('open');
    });

    // Data Clear / Reset
    const clearDataModal = document.getElementById('modal-clear-data');
    document.getElementById('btn-open-clear-data').addEventListener('click', () => clearDataModal.classList.add('open'));
    document.getElementById('btn-close-clear-data').addEventListener('click', () => clearDataModal.classList.remove('open'));

    document.getElementById('btn-action-wipe-logs-only').addEventListener('click', () => {
      studyLogs = [];
      resetTimerState();
      persistData();
      clearDataModal.classList.remove('open');
      playChime(440, 587.33);
    });

    document.getElementById('btn-action-wipe-all').addEventListener('click', () => {
      localStorage.removeItem(sKey('subjects'));
      localStorage.removeItem(sKey('logs'));
      localStorage.removeItem(sKey('tasks'));
      localStorage.removeItem(sKey('pipelines'));
      localStorage.removeItem(sKey('pomo'));
      clearActiveSessionState();

      subjects = [
        { id: 'sub-1', name: 'Core Subject', color: '#00f0ff', tag: 'Start', goalMinutes: 60 }
      ];
      studyLogs = [];
      tasks = [];
      pipelines = [];
      activeSubjectId = subjects[0].id;
      savedPomoMinutes = 25;
      
      updatePomoDuration(25);
      resetTimerState();
      persistData();
      populateTimerSubjectSelect();
      clearDataModal.classList.remove('open');
      playChime(440, 330);
    });

    // JSON Sync Tools
    const syncModal = document.getElementById('modal-sync');
    document.getElementById('btn-open-sync').addEventListener('click', () => syncModal.classList.add('open'));
    document.getElementById('btn-close-sync').addEventListener('click', () => syncModal.classList.remove('open'));

    document.getElementById('btn-export-json').addEventListener('click', () => {
      const backupData = {
        exportDate: new Date().toISOString(),
        version: "7.0",
        profile: currentProfile,
        pomoMinutes: savedPomoMinutes,
        subjects: subjects,
        studyLogs: studyLogs,
        tasks: tasks,
        pipelines: pipelines
      };
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(backupData, null, 2));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", `aetherfocus_${currentProfile}_backup_${getTodayString()}.json`);
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
    });

    document.getElementById('input-import-json').addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (event) => {
        try {
          const imported = JSON.parse(event.target.result);
          if (Array.isArray(imported.subjects)) {
            subjects = imported.subjects;
            studyLogs = imported.studyLogs || [];
            tasks = imported.tasks || [];
            pipelines = imported.pipelines || [];
            if (imported.pomoMinutes) updatePomoDuration(imported.pomoMinutes);
            
            // Clean active selection
            activeSubjectId = subjects.length > 0 ? subjects[0].id : null;
            activePipelineId = null; 

            persistData();
            populateTimerSubjectSelect();
            syncModal.classList.remove('open');
            switchTab('dashboard'); // reset view to avoid undefined active states
            playChime(659.25, 880);
          }
        } catch (err) {
          console.error('Error parsing JSON backup file', err);
          alert('Could not parse the backup file. Is it valid JSON?');
        }
      };
      reader.readAsText(file);
      e.target.value = ''; // Reset file input
    });

    // Boot
    window.addEventListener('DOMContentLoaded', loadProfileData);

  </script>
</body>
