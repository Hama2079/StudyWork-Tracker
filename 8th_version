  <script>
    // CRITICAL FIX 1: Bump Cache Name to bust user's live broken cache
    const CACHE_NAME = 'aether-focus-v4-node-update';
    const swCode = `
      self.addEventListener('install', (e) => self.skipWaiting()); 
      self.addEventListener('activate', (e) => {
        e.waitUntil(caches.keys().then(keys => Promise.all(keys.map(k => { if(k !== '${CACHE_NAME}') return caches.delete(k); }))).then(() => clients.claim()));
      });
      self.addEventListener('fetch', (e) => { e.respondWith(fetch(e.request).catch(() => caches.match(e.request))); });
    `;
    if ('serviceWorker' in navigator) { try { const swBlob = new Blob([swCode], { type: 'application/javascript' }); navigator.serviceWorker.register(URL.createObjectURL(swBlob)).catch(e => {}); } catch (e) {} }

    function openModal(id) { document.getElementById(id).classList.add('open'); }
    function closeModal(id) { document.getElementById(id).classList.remove('open'); }

    /* Custom Confirm/Prompt Logic */
    let resolveCustomAction = null;
    function promptUser(title, desc, isPrompt = false, defaultVal = '') {
      return new Promise((resolve) => {
        const modal = document.getElementById('modal-custom-action');
        document.getElementById('modal-action-title').textContent = title;
        document.getElementById('modal-action-desc').textContent = desc;
        const input = document.getElementById('modal-action-input');
        if (isPrompt) { input.classList.remove('hidden'); input.value = defaultVal; input.focus(); } 
        else { input.classList.add('hidden'); }
        
        const cleanup = (val) => { modal.classList.remove('open'); resolve(val); };
        document.getElementById('btn-action-cancel').onclick = () => cleanup(null);
        document.getElementById('btn-action-confirm').onclick = () => cleanup(isPrompt ? input.value : true);
        modal.classList.add('open');
      });
    }

    let soundMuted = false;
    function playChime(freq = 587.33, freq2 = 880) {
      if (soundMuted) return;
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext; if (!AudioContext) return;
        const ctx = new AudioContext(); const osc = ctx.createOscillator(); const gain = ctx.createGain();
        osc.type = 'sine'; osc.frequency.setValueAtTime(freq, ctx.currentTime); osc.frequency.exponentialRampToValueAtTime(freq2, ctx.currentTime + 0.18);
        gain.gain.setValueAtTime(0.25, ctx.currentTime); gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.9);
        osc.connect(gain); gain.connect(ctx.destination); osc.start(); osc.stop(ctx.currentTime + 0.9);
      } catch (e) {}
    }
    function triggerNativeNotification(title, body) { if ('Notification' in window && Notification.permission === 'granted') { try { new Notification(title, { body: body }); } catch (err) {} } }

    let wakeLockSentinel = null, wakeLockRequestedByUser = false;
    async function requestScreenWakeLock() {
      if ('wakeLock' in navigator) {
        try { wakeLockSentinel = await navigator.wakeLock.request('screen'); document.getElementById('btn-toggle-wakelock').classList.add('active'); document.getElementById('label-wakelock').textContent = 'Screen Awake: ACTIVE'; document.getElementById('wake-lock-badge').style.display = 'inline-flex'; } catch (err) {}
      }
    }
    function releaseScreenWakeLock() { if (wakeLockSentinel) { wakeLockSentinel.release().then(() => { wakeLockSentinel = null; document.getElementById('btn-toggle-wakelock').classList.remove('active'); document.getElementById('label-wakelock').textContent = 'Keep Screen Awake: Off'; document.getElementById('wake-lock-badge').style.display = 'none'; }); } }
    document.getElementById('btn-toggle-wakelock').addEventListener('click', () => { wakeLockRequestedByUser = !wakeLockRequestedByUser; wakeLockRequestedByUser ? requestScreenWakeLock() : releaseScreenWakeLock(); });
    document.getElementById('btn-toggle-notifs').addEventListener('click', async () => { if ('Notification' in window) { const res = await Notification.requestPermission(); if (res === 'granted') { document.getElementById('btn-toggle-notifs').classList.add('active'); document.getElementById('label-notifs').textContent = 'Push Alerts: ACTIVE'; document.getElementById('notif-badge').style.display = 'inline-flex'; } } });

    let profiles = JSON.parse(localStorage.getItem('aether_profiles') || '["Main"]');
    let currentProfile = localStorage.getItem('aether_profile') || profiles[0];
    if (!profiles.includes(currentProfile)) currentProfile = profiles[0];
    const sKey = (key) => `${currentProfile}_${key}`;
    const generateId = () => Math.random().toString(36).substr(2, 9);
    const getTodayString = () => new Date().toISOString().split('T')[0];

    const DEFAULT_SUBJECTS = [{ id: 'sub-1', name: 'Advanced Machine Learning', color: '#00f0ff', tag: 'AI/Tech', goalMinutes: 60 }];
    const DEFAULT_PIPELINES = [
      {
        id: 'pipe-sample-1', title: 'STM32 Firmware Build', color: '#00f0ff',
        nodes: [
          { id: 'n1', title: 'build', duration: '21s', link: '', x: 50, y: 150 },
          { id: 'n2', title: 'report-build-status', duration: '4s', link: '', x: 350, y: 50 },
          { id: 'n3', title: 'deploy', duration: '13s', link: 'https://github.io/deploy', x: 350, y: 250 }
        ],
        edges: [ { id: 'e1', source: 'n1', target: 'n2' }, { id: 'e2', source: 'n1', target: 'n3' } ]
      }
    ];

    let subjects = [], studyLogs = [], savedPomoMinutes = 25;
    let checklists = {};
    let pipelines = [];

    function renderProfileHeader() {
      const container = document.getElementById('profile-buttons-container');
      container.innerHTML = '';
      profiles.slice(0, 3).forEach(p => {
        const btn = document.createElement('button');
        btn.className = `profile-btn ${p === currentProfile ? 'active' : ''}`;
        btn.textContent = p.substring(0, 2).toUpperCase();
        btn.title = `Switch to ${p}`;
        btn.onclick = () => switchProfile(p);
        container.appendChild(btn);
      });
    }

    function switchProfile(pName) {
      if (pName === currentProfile) return;
      if (isRunning) pauseTimer();
      currentProfile = pName;
      localStorage.setItem('aether_profile', currentProfile);
      loadProfileData();
    }

    function openProfileManager() {
      const list = document.getElementById('profile-list-container');
      list.innerHTML = '';
      profiles.forEach(p => {
        const item = document.createElement('div');
        item.className = 'profile-list-item';
        
        const input = document.createElement('input');
        input.value = p;
        input.onchange = (e) => renameProfile(p, e.target.value.trim());
        
        const delBtn = document.createElement('button');
        delBtn.className = 'icon-btn';
        delBtn.style = 'width: 1.8rem; height: 1.8rem; border-color: rgba(239,68,68,0.3); color: var(--danger);';
        delBtn.innerHTML = '<svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2M10 11v6M14 11v6"/></svg>';
        
        let confirmTimeout;
        delBtn.onclick = () => {
          if (profiles.length === 1) return promptUser("Cannot Delete", "You cannot delete your only profile.");
          if (delBtn.textContent === "Sure?") {
            clearTimeout(confirmTimeout);
            deleteProfile(p);
          } else {
            delBtn.innerHTML = "<span style='font-size:0.6rem; font-weight:bold;'>Sure?</span>";
            confirmTimeout = setTimeout(() => {
               delBtn.innerHTML = '<svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2M10 11v6M14 11v6"/></svg>';
            }, 2500);
          }
        };

        item.appendChild(input);
        item.appendChild(delBtn);
        list.appendChild(item);
      });
      openModal('modal-manage-profiles');
    }

    function addProfile() {
      const input = document.getElementById('new-profile-input');
      const name = input.value.trim();
      if (!name || profiles.includes(name)) return;
      profiles.push(name);
      localStorage.setItem('aether_profiles', JSON.stringify(profiles));
      input.value = '';
      openProfileManager();
      renderProfileHeader();
    }

    function renameProfile(oldName, newName) {
      if (!newName || newName === oldName || profiles.includes(newName)) return openProfileManager();
      profiles = profiles.map(p => p === oldName ? newName : p);
      localStorage.setItem('aether_profiles', JSON.stringify(profiles));
      
      ['aether_subjects', 'aether_logs', 'aether_pomo_minutes', 'aether_checklists', 'aether_pipelines', 'aether_active_session'].forEach(key => {
        const data = localStorage.getItem(`${oldName}_${key}`);
        if (data) { localStorage.setItem(`${newName}_${key}`, data); localStorage.removeItem(`${oldName}_${key}`); }
      });
      
      if (currentProfile === oldName) {
        currentProfile = newName;
        localStorage.setItem('aether_profile', currentProfile);
      }
      openProfileManager();
      renderProfileHeader();
    }

    function deleteProfile(name) {
      profiles = profiles.filter(p => p !== name);
      localStorage.setItem('aether_profiles', JSON.stringify(profiles));
      ['aether_subjects', 'aether_logs', 'aether_pomo_minutes', 'aether_checklists', 'aether_pipelines', 'aether_active_session'].forEach(key => {
        localStorage.removeItem(`${name}_${key}`);
      });
      
      if (currentProfile === name) { switchProfile(profiles[0]); }
      else { openProfileManager(); renderProfileHeader(); }
    }

    function persistData() {
      localStorage.setItem(sKey('aether_subjects'), JSON.stringify(subjects));
      localStorage.setItem(sKey('aether_logs'), JSON.stringify(studyLogs));
      localStorage.setItem(sKey('aether_pomo_minutes'), savedPomoMinutes.toString());
      localStorage.setItem(sKey('aether_checklists'), JSON.stringify(checklists));
      localStorage.setItem(sKey('aether_pipelines'), JSON.stringify(pipelines));
      
      updateOverviewStats(); 
      renderSubjectsList(); 
      renderCalendar(); 
      renderAnalytics(); 
      
      // CRITICAL FIX 2: Only redraw dashboard if pipeline is NOT active. Prevents popping out!
      const pipelineCanvasActive = document.getElementById('pipelines-active').classList.contains('active');
      if (activePipelineId === null && !pipelineCanvasActive) { 
        renderPipelinesDashboard(); 
      }
    }

    function loadProfileData() {
      subjects = JSON.parse(localStorage.getItem(sKey('aether_subjects')) || 'null') || DEFAULT_SUBJECTS;
      studyLogs = JSON.parse(localStorage.getItem(sKey('aether_logs')) || 'null') || [];
      checklists = JSON.parse(localStorage.getItem(sKey('aether_checklists')) || 'null') || {};
      
      // CRITICAL FIX 3: Robust data sanitization for Pipelines (protect against old Kanban arrays)
      let loadedPipelines = JSON.parse(localStorage.getItem(sKey('aether_pipelines')) || 'null');
      if (loadedPipelines && Array.isArray(loadedPipelines)) {
        pipelines = loadedPipelines.map(p => ({
          id: p.id || generateId(),
          title: p.title || 'Untitled Plan',
          color: p.color || '#00f0ff',
          nodes: Array.isArray(p.nodes) ? p.nodes : [],
          edges: Array.isArray(p.edges) ? p.edges : []
        }));
      } else {
        pipelines = DEFAULT_PIPELINES;
      }

      savedPomoMinutes = parseInt(localStorage.getItem(sKey('aether_pomo_minutes')) || '25', 10);
      if (!activeSubjectId || !subjects.find(s => s.id === activeSubjectId)) { activeSubjectId = subjects.length > 0 ? subjects[0].id : null; }
      
      renderProfileHeader();
      restoreActiveSessionState(); updatePomoDuration(savedPomoMinutes); populateTimerSubjectSelect(); persistData();
    }

    const formatTime = (secs) => { const h = Math.floor(secs/3600); const m = Math.floor((secs%3600)/60); const s = secs%60; return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`; };
    const formatHours = (secs) => (secs/3600).toFixed(1) + ' hrs';
    let timerMode = 'stopwatch', pomoStage = 'focus', timerTargetSeconds = savedPomoMinutes * 60, activeSubjectId = null;
    let isRunning = false, startTimestamp = null, accumulatedSeconds = 0, totalElapsedSeconds = 0, timerTickInterval = null;
    const timerDisplay = document.getElementById('timer-display'), timerRing = document.getElementById('timer-ring'), timerStatusBadge = document.getElementById('timer-status-badge');

    function saveActiveSessionState() { localStorage.setItem(sKey('aether_active_session'), JSON.stringify({ isRunning, timerMode, pomoStage, startTimestamp, accumulatedSeconds, timerTargetSeconds, activeSubjectId, savedPomoMinutes })); }
    function clearActiveSessionState() { localStorage.removeItem(sKey('aether_active_session')); }
    function restoreActiveSessionState() {
      try {
        const state = JSON.parse(localStorage.getItem(sKey('aether_active_session'))); if(!state) { resetTimerState(); return; }
        timerMode = state.timerMode || 'stopwatch'; pomoStage = state.pomoStage || 'focus'; timerTargetSeconds = state.timerTargetSeconds; activeSubjectId = state.activeSubjectId;
        accumulatedSeconds = state.accumulatedSeconds; isRunning = state.isRunning; startTimestamp = state.startTimestamp;
        syncActiveSubjectUI();
        if (isRunning && startTimestamp) { const delta = Math.floor((Date.now() - startTimestamp) / 1000); totalElapsedSeconds = accumulatedSeconds + Math.max(0, delta); if (timerMode === 'pomodoro' && totalElapsedSeconds >= timerTargetSeconds) handleTimerCompletion(); else startOrResumeTimer(); } else { totalElapsedSeconds = accumulatedSeconds; updateTimerDial(); }
      } catch (err) { resetTimerState(); }
    }

    function syncTimeDelta() { if (!isRunning || !startTimestamp) return; totalElapsedSeconds = accumulatedSeconds + Math.max(0, Math.floor((Date.now() - startTimestamp) / 1000)); if (timerMode === 'pomodoro' && totalElapsedSeconds >= timerTargetSeconds) { handleTimerCompletion(); return; } updateTimerDial(); }
    function updateTimerDial() { if (timerMode === 'pomodoro') { const remaining = Math.max(0, timerTargetSeconds - totalElapsedSeconds); timerDisplay.textContent = formatTime(remaining); timerRing.style.strokeDashoffset = 283 - (Math.min(totalElapsedSeconds / timerTargetSeconds, 1) * 283); } else { timerDisplay.textContent = formatTime(totalElapsedSeconds); timerRing.style.strokeDashoffset = 283 - (((totalElapsedSeconds % 3600) / 3600) * 283); } }
    function startOrResumeTimer() { if (isRunning) return; isRunning = true; startTimestamp = Date.now(); saveActiveSessionState(); timerStatusBadge.textContent = (timerMode === 'pomodoro' && pomoStage !== 'focus') ? 'Resting...' : 'Session Active'; document.getElementById('timer-toggle-text').textContent = 'Pause'; document.getElementById('btn-timer-toggle').classList.replace('btn-ctrl-primary', 'btn-ctrl-pause'); if (wakeLockRequestedByUser) requestScreenWakeLock(); clearInterval(timerTickInterval); timerTickInterval = setInterval(syncTimeDelta, 500); syncTimeDelta(); }
    function pauseTimer() { if (!isRunning) return; accumulatedSeconds += Math.max(0, Math.floor((Date.now() - startTimestamp) / 1000)); totalElapsedSeconds = accumulatedSeconds; startTimestamp = null; isRunning = false; clearInterval(timerTickInterval); saveActiveSessionState(); timerStatusBadge.textContent = 'Paused'; document.getElementById('timer-toggle-text').textContent = 'Resume'; document.getElementById('btn-timer-toggle').classList.replace('btn-ctrl-pause', 'btn-ctrl-primary'); updateTimerDial(); }
    function handleTimerCompletion() { pauseTimer(); playChime(659.25, 880); const subName = subjects.find(s => s.id === activeSubjectId)?.name || 'Session'; triggerNativeNotification(pomoStage === 'focus' ? "Time's Up!" : "Break Over!", pomoStage === 'focus' ? `Logged "${subName}".` : "Ready to focus?"); timerStatusBadge.textContent = pomoStage === 'focus' ? 'Session Complete!' : 'Break Finished!'; if (pomoStage === 'focus') stopAndLogTimer(); }
    function stopAndLogTimer() { if (isRunning) { accumulatedSeconds += Math.floor((Date.now() - startTimestamp) / 1000); totalElapsedSeconds = accumulatedSeconds; } const durationToLog = (timerMode === 'pomodoro') ? Math.min(totalElapsedSeconds, timerTargetSeconds) : totalElapsedSeconds; if (durationToLog >= 5 && (timerMode === 'stopwatch' || pomoStage === 'focus')) { studyLogs.unshift({ id: 'log-' + Date.now(), subjectId: activeSubjectId, duration: durationToLog, timestamp: new Date().toISOString(), dateString: getTodayString(), note: document.getElementById('timer-session-note').value.trim() }); persistData(); playChime(523.25, 783.99); } resetTimerState(); document.getElementById('timer-session-note').value = ''; }
    function resetTimerState() { clearInterval(timerTickInterval); isRunning = false; startTimestamp = null; accumulatedSeconds = 0; totalElapsedSeconds = 0; clearActiveSessionState(); timerStatusBadge.textContent = 'Ready'; document.getElementById('timer-toggle-text').textContent = 'Start Focus'; document.getElementById('btn-timer-toggle').classList.replace('btn-ctrl-pause', 'btn-ctrl-primary'); updateTimerDial(); }
    document.getElementById('btn-timer-toggle').addEventListener('click', () => { isRunning ? pauseTimer() : startOrResumeTimer(); });
    document.getElementById('btn-timer-stop').addEventListener('click', stopAndLogTimer);

    function updatePomoDuration(mins) { savedPomoMinutes = Math.max(1, Math.min(180, parseInt(mins, 10) || 25)); localStorage.setItem(sKey('aether_pomo_minutes'), savedPomoMinutes.toString()); document.getElementById('input-pomo-minutes').value = savedPomoMinutes; document.getElementById('pomo-selected-label').textContent = `${savedPomoMinutes} Minutes`; document.querySelectorAll('.preset-chip').forEach(c => c.classList.toggle('active', parseInt(c.dataset.mins) === savedPomoMinutes)); if (timerMode === 'pomodoro' && pomoStage === 'focus') { timerTargetSeconds = savedPomoMinutes * 60; if (!isRunning) resetTimerState(); else saveActiveSessionState(); } }
    document.querySelectorAll('.preset-chip').forEach(c => c.addEventListener('click', () => updatePomoDuration(c.dataset.mins)));
    document.getElementById('btn-step-dec').addEventListener('click', () => updatePomoDuration(savedPomoMinutes - 5)); document.getElementById('btn-step-inc').addEventListener('click', () => updatePomoDuration(savedPomoMinutes + 5));

    document.getElementById('btn-mode-stopwatch').addEventListener('click', function() { this.classList.add('active'); document.getElementById('btn-mode-pomodoro').classList.remove('active'); document.getElementById('pomo-customizer-box').classList.add('hidden'); document.getElementById('pomo-stage-bar').classList.add('hidden'); timerMode = 'stopwatch'; syncActiveSubjectUI(); resetTimerState(); });
    document.getElementById('btn-mode-pomodoro').addEventListener('click', function() { this.classList.add('active'); document.getElementById('btn-mode-stopwatch').classList.remove('active'); document.getElementById('pomo-customizer-box').classList.remove('hidden'); document.getElementById('pomo-stage-bar').classList.remove('hidden'); timerMode = 'pomodoro'; setPomoStage('focus'); resetTimerState(); });
    document.querySelectorAll('.pomo-stage-btn').forEach(btn => btn.addEventListener('click', () => setPomoStage(btn.dataset.stage)));
    function setPomoStage(stage) { pomoStage = stage; document.querySelectorAll('.pomo-stage-btn').forEach(b => b.classList.toggle('active', b.dataset.stage === stage)); if (stage === 'focus') { timerTargetSeconds = savedPomoMinutes * 60; syncActiveSubjectUI(); } else if (stage === 'shortBreak') { timerTargetSeconds = 5 * 60; timerRing.style.stroke = 'var(--break-green)'; } else if (stage === 'longBreak') { timerTargetSeconds = 15 * 60; timerRing.style.stroke = 'var(--break-purple)'; } resetTimerState(); }

    function populateTimerSubjectSelect() { const sel = document.getElementById('timer-subject-select'); sel.innerHTML = ''; subjects.forEach(s => { const opt = document.createElement('option'); opt.value = s.id; opt.textContent = s.name; if(s.id === activeSubjectId) opt.selected = true; sel.appendChild(opt); }); syncActiveSubjectUI(); }
    function syncActiveSubjectUI() { const sub = subjects.find(s => s.id === activeSubjectId) || subjects[0]; if (sub) { document.getElementById('timer-selected-title').textContent = sub.name; if (timerMode !== 'pomodoro' || pomoStage === 'focus') timerRing.style.stroke = sub.color; } }
    document.getElementById('timer-subject-select').addEventListener('change', (e) => { activeSubjectId = e.target.value; syncActiveSubjectUI(); saveActiveSessionState(); });

    function updateOverviewStats() {
      const today = getTodayString(), pastWeek = new Date(); pastWeek.setDate(pastWeek.getDate() - 7);
      let todaySecs = 0, weekSecs = 0, allTimeSecs = 0;
      studyLogs.forEach(l => { allTimeSecs += l.duration; if(l.dateString === today) todaySecs += l.duration; if(new Date(l.dateString) >= pastWeek) weekSecs += l.duration; });
      document.getElementById('stat-today').textContent = formatTime(todaySecs); document.getElementById('stat-week').textContent = formatHours(weekSecs); document.getElementById('stat-subjects-count').textContent = subjects.length; document.getElementById('stat-alltime-sub').textContent = `All-time: ${formatHours(allTimeSecs)}`;
      let streak = 0, check = new Date(), activeDays = new Set(studyLogs.map(l => l.dateString));
