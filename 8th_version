    document.getElementById('btn-export-json').addEventListener('click', () => { const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify({ exportDate: new Date().toISOString(), profile: currentProfile, pomoMinutes: savedPomoMinutes, subjects, studyLogs, checklists, pipelines }, null, 2)); const a = document.createElement('a'); a.href = dataStr; a.download = `aetherfocus_backup_${getTodayString()}.json`; document.body.appendChild(a); a.click(); a.remove(); });
    document.getElementById('input-import-json').addEventListener('change', (e) => { const file = e.target.files[0]; if (!file) return; const reader = new FileReader(); reader.onload = (event) => { try { const imp = JSON.parse(event.target.result); if (Array.isArray(imp.subjects) && Array.isArray(imp.studyLogs)) { subjects = imp.subjects; studyLogs = imp.studyLogs; if (imp.checklists) checklists = imp.checklists; if (imp.pipelines) pipelines = imp.pipelines; if (imp.pomoMinutes) updatePomoDuration(imp.pomoMinutes); persistData(); populateTimerSubjectSelect(); closeModal('modal-sync'); playChime(659.25, 880); } } catch (err) {} }; reader.readAsText(file); });
    document.getElementById('btn-toggle-sound').addEventListener('click', () => { soundMuted = !soundMuted; document.getElementById('btn-toggle-sound').style.opacity = soundMuted ? '0.4' : '1'; });

    let selectedColor = '#00f0ff';
    document.querySelectorAll('.color-option').forEach(opt => {
      opt.addEventListener('click', () => {
        document.querySelectorAll('.color-option').forEach(o => o.classList.remove('selected'));
        opt.classList.add('selected');
        selectedColor = opt.getAttribute('data-color');
      });
    });

    window.addEventListener('DOMContentLoaded', () => loadProfileData());
  </script>
</body>
</html>
