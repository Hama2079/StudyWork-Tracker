          </div>`;

        item.querySelector('.checklist-checkbox').addEventListener('change', (e) => { tasks[index].done = e.target.checked; persistData(); renderChecklist(dateStr); });
        const textEl = item.querySelector('.checklist-task-text');
        textEl.addEventListener('blur', () => { if(textEl.textContent.trim()) { tasks[index].text = textEl.textContent.trim(); persistData(); } else { textEl.textContent = tasks[index].text; } });
        textEl.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); textEl.blur(); } });
        item.querySelector('.del-task-btn').addEventListener('click', () => { tasks.splice(index, 1); persistData(); renderChecklist(dateStr); });

        item.addEventListener('dragstart', () => { draggedChecklistTaskIndex = index; item.classList.add('dragging'); });
        item.addEventListener('dragend', () => { item.classList.remove('dragging'); draggedChecklistTaskIndex = null; });
        item.addEventListener('dragover', e => e.preventDefault());
        item.addEventListener('drop', e => { e.preventDefault(); if (draggedChecklistTaskIndex !== null && draggedChecklistTaskIndex !== index) { const moved = tasks.splice(draggedChecklistTaskIndex, 1)[0]; tasks.splice(index, 0, moved); persistData(); renderChecklist(dateStr); } });
