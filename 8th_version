            if (!exists) { pipe.edges.push({ id: generateId(), source: drawingEdgeSourceId, target: targetNodeId }); persistData(); renderNodeGraph(); }
          }
        }
        drawingEdgeSourceId = null;
        edgePreview.style.display = 'none';
      }
    });

