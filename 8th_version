    }

    async function addPipelineNode(clientX = 100, clientY = 100) {
      if (!activePipelineId) return;
      const pipe = pipelines.find(p => p.id === activePipelineId);
      const val = await promptUser("New Node", "Enter title, duration (optional) (comma separated)", true, "build, 10s");
      if (val) {
        const parts = val.split(',');
        pipe.nodes.push({ id: generateId(), title: parts[0]?.trim() || 'Node', duration: parts[1]?.trim() || '', link: '', x: clientX, y: clientY });
        persistData(); renderNodeGraph();
      }
    }

    window.addEventListener('mousemove', (e) => {
      if (!activePipelineId) return;
      const editorCanvas = document.getElementById('pipeline-canvas');
      if(!editorCanvas) return;
      
      const rect = editorCanvas.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;

      if (draggedGHNode) {
        draggedGHNode.x = mouseX - ghNodeOffset.x;
        draggedGHNode.y = mouseY - ghNodeOffset.y;
        updateNodePosition(draggedGHNode);
      } 
      else if (drawingEdgeSourceId) {
        const sNodeDiv = document.querySelector(`.gh-node[data-id="${drawingEdgeSourceId}"]`);
        if (sNodeDiv) {
          const sRect = sNodeDiv.getBoundingClientRect();
          const startX = (sRect.right - rect.left) + 6;
          const startY = (sRect.top + sRect.height/2) - rect.top;
          edgePreview.setAttribute('d', getBezierPath(startX, startY, mouseX, mouseY));
        }
      }
    });

    window.addEventListener('mouseup', (e) => {
      if (draggedGHNode) { persistData(); draggedGHNode = null; }
      if (drawingEdgeSourceId) {
        const portIn = e.target.closest('.gh-port-in');
        if (portIn) {
          const targetNodeId = portIn.closest('.gh-node').dataset.id;
          if (drawingEdgeSourceId !== targetNodeId) {
            const pipe = pipelines.find(p => p.id === activePipelineId);
