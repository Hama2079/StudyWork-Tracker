    function getBezierPath(startX, startY, endX, endY) {
      const curvature = Math.max(Math.abs(endX - startX) / 2, 40);
      return `M ${startX} ${startY} C ${startX + curvature} ${startY}, ${endX - curvature} ${endY}, ${endX} ${endY}`;
    }

    function renderNodeGraph() {
      if (!activePipelineId) return;
      const pipe = pipelines.find(p => p.id === activePipelineId);
      if (!pipe) return;
      
      document.getElementById('active-pipeline-title').textContent = pipe.title;
      document.getElementById('active-pipeline-title').style.color = pipe.color;
      
      edgesGroup.innerHTML = '';
      nodesLayer.innerHTML = '';
      
      if (!pipe.nodes) pipe.nodes = [];
      if (!pipe.edges) pipe.edges = [];
      
      pipe.nodes.forEach(node => {
        const div = document.createElement('div');
        div.className = 'gh-node';
        div.dataset.id = node.id;
        div.style.left = `${node.x}px`;
        div.style.top = `${node.y}px`;
        
        const checkSvg = `<svg class="gh-icon-check" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"></path></svg>`;
        
        div.innerHTML = `
          <button class="gh-node-delete" title="Delete Node">X</button>
          <div class="gh-node-header">
            <div class="gh-node-title-group">
              ${checkSvg}
              <span class="gh-node-title">${node.title}</span>
            </div>
            <span class="gh-node-duration">${node.duration || ''}</span>
          </div>
          ${node.link ? `<a href="${node.link}" class="gh-node-link" target="_blank" onclick="event.stopPropagation()">${node.link}</a>` : ''}
          <div class="gh-port gh-port-in" data-type="in"></div>
          <div class="gh-port gh-port-out" data-type="out"></div>
        `;

        // CRITICAL FIX 4: Strong event isolation for dragging
        div.addEventListener('mousedown', (e) => {
          if (e.target.classList.contains('gh-port') || e.target.tagName === 'A' || e.target.tagName === 'BUTTON') return;
          e.preventDefault(); 
          e.stopPropagation(); 
          const rect = div.getBoundingClientRect();
          draggedGHNode = node;
          ghNodeOffset = { x: e.clientX - rect.left, y: e.clientY - rect.top };
        });

        const portOut = div.querySelector('.gh-port-out');
        portOut.addEventListener('mousedown', (e) => {
          e.preventDefault();
          e.stopPropagation();
          drawingEdgeSourceId = node.id;
          edgePreview.style.display = 'block';
        });

        div.querySelector('.gh-node-delete').addEventListener('click', (e) => {
          e.stopPropagation();
          pipe.nodes = pipe.nodes.filter(n => n.id !== node.id);
          pipe.edges = pipe.edges.filter(edge => edge.source !== node.id && edge.target !== node.id);
          persistData(); renderNodeGraph();
        });

        // CRITICAL FIX 4: Isolate double click text-edit
        div.addEventListener('dblclick', async (e) => {
          e.stopPropagation();
          if (e.target.classList.contains('gh-port')) return;
          const newTitle = await promptUser("Edit Node", "Enter title, duration, link (comma separated)", true, `${node.title},${node.duration||''},${node.link||''}`);
          if (newTitle) {
            const parts = newTitle.split(',');
            node.title = parts[0]?.trim() || 'Node';
            node.duration = parts[1]?.trim() || '';
            node.link = parts[2]?.trim() || '';
            persistData(); renderNodeGraph();
          }
        });

        nodesLayer.appendChild(div);
      });

      setTimeout(() => updateAllEdges(), 0);
    }

    function updateAllEdges() {
      if (!activePipelineId) return;
      const pipe = pipelines.find(p => p.id === activePipelineId);
      if(!pipe) return;
      const canvasRect = document.getElementById('pipeline-canvas').getBoundingClientRect();
      edgesGroup.innerHTML = '';

      pipe.edges.forEach(edge => {
        const sNode = document.querySelector(`.gh-node[data-id="${edge.source}"]`);
        const tNode = document.querySelector(`.gh-node[data-id="${edge.target}"]`);
        if (sNode && tNode) {
          const sRect = sNode.getBoundingClientRect();
          const tRect = tNode.getBoundingClientRect();
          
          const startX = (sRect.right - canvasRect.left) + 6;
          const startY = (sRect.top + sRect.height/2) - canvasRect.top;
          const endX = (tRect.left - canvasRect.left) - 6;
          const endY = (tRect.top + tRect.height/2) - canvasRect.top;

          const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
          path.setAttribute("d", getBezierPath(startX, startY, endX, endY));
          path.setAttribute("class", "pipeline-edge");
          path.dataset.edgeId = edge.id;
          path.onclick = (e) => {
            e.stopPropagation();
            pipe.edges = pipe.edges.filter(x => x.id !== edge.id);
            persistData(); updateAllEdges();
          };
          edgesGroup.appendChild(path);
        }
      });
    }

    function updateNodePosition(node) {
